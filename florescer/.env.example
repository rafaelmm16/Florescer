# URI de Conexão com o MongoDB Atlas
MONGODB_URI="mongodb+srv://<SEU_USUARIO>:<SUA_SENHA>@<SEU_CLUSTER>.mongodb.net"

# Porta do Servidor Local Backend
PORT=3001
